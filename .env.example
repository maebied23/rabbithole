# Optional local AI configuration. Never use NEXT_PUBLIC_ for a key.
# The app makes no AI requests until enabled and the user clicks Get an explanation.
RABBITHOLE_ENABLE_AI=false
OPENAI_API_KEY=
# Choose a Responses API model supporting structured outputs from your account.
OPENAI_MODEL=
# Total attempts per server process, including failures. Resets on process restart.
RABBITHOLE_AI_CALL_LIMIT=10
